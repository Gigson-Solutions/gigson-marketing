# Cal.com — URL del widget de reservas para Gigson Solutions
# Self-hosted: https://cal.gigsonsolutions.com/gigsonsolutions/30min
VITE_CALCOM_GIGSON_URL=https://cal.gigsonsolutions.com/gigsonsolutions/30min

# Payload CMS — required for blog and admin panel
# Generate a long random string (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=

# Neon PostgreSQL connection string (or any PostgreSQL provider)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URI=

# Chatbot (Alfonso) — Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar (default claude-sonnet-4-6). Para una demo más barata: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# Envío de leads del chatbot por email (vía FormSubmit.co, mismo destinatario que el form de contacto)
LEAD_EMAIL_TO=jaume@somosgigson.com
LEAD_EMAIL_CC=alfonso.ojeda@gigsonsolutions.com
# Pon LEAD_EMAIL_DISABLE=true para no enviar email (solo log) en local/dev.
LEAD_EMAIL_DISABLE=false

# ── Google Workspace SSO — Payload CMS /admin ───────────────────────────────
# Crear en: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID → Web application → Authorized redirect URIs:
#   http://localhost:3000/api/users/oauth/callback
#   https://<staging-url>/api/users/oauth/callback
#   https://gigsonsolutions.com/api/users/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública del deployment — sin trailing slash. Debe coincidir con la redirect URI de Google.
# local:   http://localhost:3000
# staging: https://gigson-marketing-git-staging-awesomelygroup.vercel.app
# prod:    https://gigsonsolutions.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Blog: Media uploads (Vercel Blob) ───────────────────────────────────────
# Vercel > Project > Storage > Create Database > Blob. Copia el token generado.
# El filesystem de Vercel es efímero/solo lectura en producción, así que las
# imágenes de la colección `media` se guardan en Blob, no en disco local.
BLOB_READ_WRITE_TOKEN=

# ── Blog: botón "Preview" en Payload (Draft Mode de Next.js) ────────────────
# Cualquier string aleatorio largo, ej: openssl rand -hex 16
# Permite previsualizar un post en borrador con el diseño real, sin publicarlo.
PAYLOAD_PREVIEW_SECRET=
